    "Use TMDB watch provider numbers; pipes mean any of them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende TMDB-Anbieternummern; senkrechte Striche bedeuten „beliebige davon“."
