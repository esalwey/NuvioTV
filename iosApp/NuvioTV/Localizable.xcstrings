    "The sharp backdrop, with the trailer playing behind the page when it has one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der scharfe Hintergrund, mit dem Trailer im Hintergrund der Seite, sofern vorhanden."
          }
        },
        "es": {
