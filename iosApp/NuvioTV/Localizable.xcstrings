          "stringUnit": {
            "state": "translated",
            "value": "Lo sfondo resta scuro e uniforme"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nền giữ màu tối đơn sắc"
          }
        }
      }
    },
    "The focused title's colors tint the background behind the rows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farben des fokussierten Titels färben den Hintergrund hinter den Reihen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores del título enfocado tiñen el fondo detrás de las filas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couleurs du titre sélectionné teintent l’arrière-plan derrière les rangées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colori del titolo in primo piano colorano lo sfondo dietro le righe"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu của phim đang chọn nhuộm nền phía sau các hàng"
          }
        }
      }
    },
    "The next episode appears before it airs, with a countdown": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Episode erscheint schon vor der Ausstrahlung, mit Countdown"
          }
