    "Guest data on this Apple TV (profiles, library, watch progress) will be cleared. You can then sign in on the welcome screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastdaten auf diesem Apple TV (Profile, Mediathek, Ansichtsverlauf) werden gelöscht. Du kannst dich dann auf dem Willkommensbildschirm anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de invitado en este Apple TV (perfiles, biblioteca, progreso de visualización) se borrarán. Luego puedes iniciar sesión en la pantalla de bienvenida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données invité de cette Apple TV (profils, bibliothèque, progression de visionnage) seront effacées. Vous pourrez ensuite vous connecter depuis l’écran de bienvenue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati guest su questo Apple TV (profili, libreria, progresso di visione) verranno cancellati. Puoi quindi accedere alla schermata di benvenuto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu khách trên Apple TV này (hồ sơ, thư viện, tiến độ xem) sẽ bị xóa. Sau đó bạn có thể đăng nhập ở màn hình chào."
          }
        }
      }
    },
