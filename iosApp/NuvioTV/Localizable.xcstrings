    "Intro and credits timings come from IntroDB and AniSkip. Anime Skip adds more anime. Credentials sync with your account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intro- und Abspann-Zeiten stammen von IntroDB und AniSkip. Anime Skip ergänzt weitere Anime. Zugangsdaten werden mit deinem Konto synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las marcas de intros y créditos proceden de IntroDB y AniSkip. Anime Skip añade más anime. Las credenciales se sincronizan con tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les repères d’intro et de générique viennent d’IntroDB et d’AniSkip. Anime Skip ajoute d’autres animes. Les identifiants se synchronisent avec votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tempi di intro e titoli di coda provengono da IntroDB e AniSkip. Anime Skip aggiunge altri anime. Le credenziali si sincronizzano con il tuo account."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mốc thời gian phần mở đầu và credit lấy từ IntroDB và AniSkip. Anime Skip bổ sung thêm anime. Thông tin đăng nhập đồng bộ với tài khoản của bạn."
          }
        }
      }
    },
