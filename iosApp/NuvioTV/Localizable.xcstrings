    "Sync your library, watch progress, and profiles across devices. Local guest data on this Apple TV will be cleared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere deine Mediathek, deinen Ansichtsverlauf und deine Profile auf allen Geräten. Lokale Gastdaten auf diesem Apple TV werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tu biblioteca, progreso de visualización y perfiles en dispositivos. Los datos de invitado locales en este Apple TV se borrarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez votre bibliothèque, votre progression et vos profils entre appareils. Les données invité locales de cette Apple TV seront effacées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza la tua libreria, il progresso di visione e i profili su tutti i dispositivi. I dati guest locali su questo Apple TV verranno cancellati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ thư viện, tiến độ xem và hồ sơ giữa các thiết bị. Dữ liệu khách cục bộ trên Apple TV này sẽ bị xóa."
          }
        }
      }
    },
