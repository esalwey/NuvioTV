          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-en un dans Paramètres → Compte et services → Debrid, ou activez « Résoudre les streams avec Debrid »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti uno in Impostazioni → Account e servizi → Debrid, o attiva \"Risolvi flussi con Debrid\"."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối trong Cài đặt → Tài khoản & dịch vụ → Debrid, hoặc bật “Phân giải luồng bằng Debrid”."
