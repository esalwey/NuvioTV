    },
    "settings.external.forwardSubtitles.subtitle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Fetch subtitles from your add-ons in your preferred and secondary subtitle languages and pass them to the external player. Not used when Subtitles is set to None."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hole Untertitel von deinen Add-ons in deinen bevorzugten und sekundären Untertitelsprachen und übergib sie an den externen Player. Wird nicht verwendet, wenn „Untertitel“ auf „Aus“ steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiene subtítulos de tus complementos en tus idiomas de subtítulos preferido y secundario y se los pasa al reproductor externo. No se usa cuando Subtítulos está en Ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère les sous-titres de vos add-ons dans vos langues de sous-titres principale et secondaire, et les transmet au lecteur externe. Inutilisé quand les sous-titres sont réglés sur Aucun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera i sottotitoli dai tuoi addon nelle lingue dei sottotitoli preferita e secondaria e li passa al lettore esterno. Non usato quando Sottotitoli è impostato su Nessuno."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấy phụ đề từ addon theo ngôn ngữ phụ đề ưu tiên và thứ cấp của bạn rồi chuyển cho trình phát ngoài. Không dùng khi Phụ đề đặt là Tắt."
          }
        }
      }
    },
    "settings.lastLink.duration": {
      "extractionState": "extracted_with_value",
      "localizations": {
