    "settings.streams.verifyLanguages.subtitle": {
      "comment": "Explanation under the Verify Source Languages toggle",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reads a few hundred KB of each top source (only ready-to-play links, never a torrent that still needs downloading) to list its real audio and subtitle tracks. Verified languages show a seal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit quelques centaines de Ko de chaque source en tête de liste (uniquement les liens prêts à lire, jamais un torrent encore à télécharger) pour connaître ses vraies pistes audio et sous-titres. Les langues vérifiées portent un sceau."
          }
        }
      }
    },
    "streams.resolve.timeout": {
