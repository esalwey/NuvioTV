    "Your %@ session has expired. Reconnect in Settings → Account & Services → Debrid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine %@-Sitzung ist abgelaufen. Verbinde dich erneut unter Einstellungen → Konto & Dienste → Debrid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de %@ ha caducado. Vuelve a conectar en Ajustes → Cuenta y servicios → Debrid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session %@ a expiré. Reconnectez-vous dans Paramètres → Compte et services → Debrid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sessione %@ è scaduta. Riconnettiti in Impostazioni → Account e servizi → Debrid."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên %@ của bạn đã hết hạn. Kết nối lại trong Cài đặt → Tài khoản & dịch vụ → Debrid."
          }
        }
      }
    },
    "Your add-ons don't expose browsable catalogs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Add-ons stellen keine durchsuchbar Kataloge bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus complementos no exponen catálogos navegables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos add-ons n’exposent aucun catalogue navigable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi componenti aggiuntivi non espongono cataloghi sfogliabili."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Addon của bạn không có danh mục để duyệt."
          }
        }
      }
    },
    "Your installed addons either don’t serve streams, or don’t cover this content type.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos add-ons installés ne fournissent pas de streams, ou ne couvrent pas ce type de contenu."
          }
        }
      }
    },
    "Your library is empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek ist leer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca está vacía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque est vide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è vuota"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có nội dung đã lưu"
          }
        }
      }
    },
    "You’ll be signed out of the current server and local data on this Apple TV will be cleared. Your synced data stays on its own server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst vom aktuellen Server abgemeldet und lokale Daten auf diesem Apple TV werden gelöscht. Deine synchronisierten Daten bleiben auf ihrem eigenen Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará tu sesión en el servidor actual y los datos locales en este Apple TV se borrarán. Tus datos sincronizados permanecen en su propio servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez déconnecté du serveur actuel et les données locales de cette Apple TV seront effacées. Vos données synchronisées restent sur leur propre serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrai disconnesso dal server corrente e i dati locali su questo Apple TV verranno cancellati. I tuoi dati sincronizzati rimangono sul rispettivo server."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ bị đăng xuất khỏi máy chủ hiện tại và dữ liệu cục bộ trên Apple TV này sẽ bị xóa. Dữ liệu đã đồng bộ vẫn còn trên máy chủ riêng của nó."
          }
        }
      }
    },
    "You’ll be signed out of the self-hosted server and local data on this Apple TV will be cleared. Nuvio will reconnect to api.nuvio.tv.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst vom selbst gehosteten Server abgemeldet und lokale Daten auf diesem Apple TV werden gelöscht. Nuvio verbindet sich wieder mit api.nuvio.tv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará tu sesión en el servidor autoalojado y los datos locales en este Apple TV se borrarán. Nuvio volverá a conectarse a api.nuvio.tv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez déconnecté du serveur auto-hébergé et les données locales de cette Apple TV seront effacées. Nuvio se reconnectera à api.nuvio.tv."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrai disconnesso dal server self-hosted e i dati locali su questo Apple TV verranno cancellati. Nuvio si riconnetterà ad api.nuvio.tv."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ bị đăng xuất khỏi máy chủ tự lưu trữ và dữ liệu cục bộ trên Apple TV này sẽ bị xóa. Nuvio sẽ kết nối lại với api.nuvio.tv."
          }
        }
      }
    },
