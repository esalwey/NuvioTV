        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bibliothèques sélectionnées apparaissent dans les rangées de l’accueil, la bibliothèque, la recherche et les résultats de flux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le librerie selezionate compaiono nelle righe home, nella libreria, nella ricerca e nei risultati degli stream."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thư viện đã chọn xuất hiện trong các hàng Trang chủ, Thư viện, tìm kiếm và kết quả luồng phát."
          }
        }
      }
    },
    "Selected values sort first, in the default order, when results are sorted by quality, audio or language. At least one stays on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Werte werden in der Standardreihenfolge zuerst sortiert, wenn Ergebnisse nach Qualität, Audio oder Sprache sortiert sind. Mindestens einer bleibt aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores seleccionados van primero, en el orden predeterminado, cuando los resultados se ordenan por calidad, audio o idioma. Siempre queda al menos uno activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sélectionnées passent en premier, dans l’ordre par défaut, quand les résultats sont triés par qualité, audio ou langue. Au moins une reste activée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori selezionati vengono ordinati per primi, nell’ordine predefinito, quando i risultati sono ordinati per qualità, audio o lingua. Almeno uno resta attivo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giá trị đã chọn xếp trước, theo thứ tự mặc định, khi kết quả được sắp xếp theo chất lượng, âm thanh hoặc ngôn ngữ. Luôn bật ít nhất một mục."
          }
        }
      }
    },
