    },
    "Device sign-in isn't configured in this build (missing PREMIUMIZE_CLIENT_ID). Paste an API key from your Premiumize account instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte-Anmeldung ist in dieser Version nicht konfiguriert (fehlende PREMIUMIZE_CLIENT_ID). Füge stattdessen einen API-Schlüssel aus deinem Premiumize-Konto ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión del dispositivo no está configurado en esta compilación (falta PREMIUMIZE_CLIENT_ID). Pega una clave API de tu cuenta de Premiumize en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion par appareil n’est pas configurée dans cette version (PREMIUMIZE_CLIENT_ID manquant). Collez plutôt une clé API de votre compte Premiumize."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al dispositivo non è configurato in questa build (manca PREMIUMIZE_CLIENT_ID). Incolla invece una chiave API dal tuo account Premiumize."
