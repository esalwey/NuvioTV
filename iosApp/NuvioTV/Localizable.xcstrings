    "Servers on your home network work over plain HTTP. Your password is only used to sign in and is never stored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server in deinem Heimnetzwerk funktionieren über einfaches HTTP. Dein Passwort wird nur zur Anmeldung verwendet und nie gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores de tu red doméstica funcionan con HTTP sin cifrar. Tu contraseña solo se usa para iniciar sesión y nunca se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs de votre réseau domestique fonctionnent en HTTP simple. Votre mot de passe sert uniquement à vous connecter et n’est jamais enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I server della tua rete domestica funzionano con HTTP semplice. La tua password serve solo per accedere e non viene mai salvata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ trong mạng gia đình của bạn hoạt động qua HTTP thường. Mật khẩu của bạn chỉ dùng để đăng nhập và không bao giờ được lưu."
          }
        }
      }
    },
