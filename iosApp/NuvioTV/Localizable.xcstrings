      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API %@"
          }
        }
      }
    },
    "%@ didn't accept this key. Check it and try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté cette clé. Vérifiez-la et réessayez."
          }
        }
      }
    },
    "%@ f=%lld t=%lld y=%lld i=%lld r=%lld": {
      "shouldTranslate": false
    },
    "%@ has no device sign-in here: paste the API key from your %@ account. It resolves the links of add-ons that hand them to %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas de connexion par code ici : collez la clé API de votre compte %@. Elle résout les liens des add-ons qui les confient à %@."
          }
        }
      }
    },
    "%@ of the episode": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de l’épisode"
          }
        }
      }
    },
    "%@ rejected the saved sign-in. Press to disconnect, then connect again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die gespeicherte Anmeldung abgelehnt. Drücke zum Trennen und verbinde dich dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rechazó el inicio de sesión guardado. Pulsa para desconectar y vuelve a conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a rejeté la connexion enregistrée. Appuyez pour déconnecter, puis reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rifiutato l'accesso salvato. Premi per disconnettere, poi connettiti di nuovo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã từ chối đăng nhập đã lưu. Nhấn để ngắt kết nối, rồi kết nối lại."
          }
        }
      }
    },
