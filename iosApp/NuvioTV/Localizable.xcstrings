    "Sign in to sync your library, watch progress, and profiles across devices — or continue as a guest on this Apple TV only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine Mediathek, Ansichtsverlauf und Profile auf allen Geräten zu synchronisieren – oder fahre als Gast nur auf diesem Apple TV fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para sincronizar tu biblioteca, progreso de visualización y perfiles en dispositivos — o continúa como invitado solo en este Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour synchroniser votre bibliothèque, votre progression et vos profils entre appareils — ou continuez en tant qu’invité sur cette Apple TV uniquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per sincronizzare la tua libreria, il progresso di visione e i profili su tutti i dispositivi — o continua come ospite solo su questo Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để đồng bộ thư viện, tiến độ xem và hồ sơ giữa các thiết bị — hoặc tiếp tục làm khách chỉ trên Apple TV này."
          }
        }
      }
    },
    "Sign in with your email and password to get started.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit deiner E-Mail-Adresse und deinem Passwort an, um loszulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu correo y contraseña para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre e-mail et votre mot de passe pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con la tua email e password per iniziare."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng email và mật khẩu của bạn để bắt đầu."
          }
        }
      }
    },
    "Sign in with your phone — scan a QR code, no typing on the remote.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit deinem Phone an – scanne einen QR-Code, kein Tippen auf der Fernbedienung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu teléfono — escanea un código QR, sin escritura en el control remoto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre téléphone — scannez un code QR, aucune saisie avec la télécommande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con il tuo telefono — scansiona un codice QR, nessuna digitazione sul telecomando."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng điện thoại — quét mã QR, không cần gõ trên remote."
          }
        }
      }
    },
    "Sign out?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden?"
          }
        },
        "es": {
