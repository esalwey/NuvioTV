    "The background stays a flat dark": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund bleibt einfarbig dunkel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo permanece de un oscuro liso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrière-plan reste d’un sombre uni"
          }
        },
