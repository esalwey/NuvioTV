    "Watch updates from this profile stop and this Apple TV's MDBList authorization is revoked. Your MDBList history and lists are untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe-Updates dieses Profils werden gestoppt und die MDBList-Autorisierung dieses Apple TV wird widerrufen. Dein MDBList-Verlauf und deine Listen bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones de visionado de este perfil se detienen y se revoca la autorización de MDBList de este Apple TV. Tu historial y tus listas de MDBList no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour de visionnage de ce profil s’arrêtent et l’autorisation MDBList de cette Apple TV est révoquée. Votre historique et vos listes MDBList restent intacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti di visione di questo profilo si interrompono e l’autorizzazione MDBList di questo Apple TV viene revocata. La tua cronologia e le tue liste MDBList rimangono intatte."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cập nhật xem từ hồ sơ này sẽ dừng và quyền MDBList của Apple TV này bị thu hồi. Lịch sử và danh sách MDBList của bạn không bị ảnh hưởng."
          }
        }
      }
    },
