          "stringUnit": {
            "state": "translated",
            "value": "Woher die Empfehlungen auf der Seite eines Titels stammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De dónde proceden las recomendaciones de la página de un título."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’où proviennent les recommandations sur la page d’un titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da dove provengono i consigli nella pagina di un titolo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi lấy đề xuất trên trang phim."
          }
        }
      }
    },
    "Spatial Audio for TrueHD Atmos and DTS:X": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räumlicher Klang für TrueHD Atmos und DTS:X"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio espacial para TrueHD Atmos y DTS:X"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio spatial pour TrueHD Atmos et DTS:X"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio spaziale per TrueHD Atmos e DTS:X"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh không gian cho TrueHD Atmos và DTS:X"
          }
        }
      }
    },
    "Play TrueHD Atmos and DTS:X tracks as Dolby Atmos, with their height channels. The Apple TV converts the audio as it plays; tracks it cannot convert play as before.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt TrueHD-Atmos- und DTS:X-Spuren als Dolby Atmos mit ihren Höhenkanälen ab. Die Apple TV wandelt den Ton während der Wiedergabe um; Spuren, die sich nicht umwandeln lassen, werden wie bisher abgespielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce las pistas TrueHD Atmos y DTS:X como Dolby Atmos, con sus canales de altura. El Apple TV convierte el audio durante la reproducción; las pistas que no puede convertir se reproducen como antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les pistes TrueHD Atmos et DTS:X en Dolby Atmos, avec leurs canaux de hauteur. L’Apple TV convertit le son pendant la lecture ; les pistes qu’elle ne peut pas convertir sont lues comme avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce le tracce TrueHD Atmos e DTS:X come Dolby Atmos, con i loro canali in altezza. L’Apple TV converte l’audio durante la riproduzione; le tracce che non può convertire vengono riprodotte come prima."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát các bản âm thanh TrueHD Atmos và DTS:X dưới dạng Dolby Atmos, cùng các kênh độ cao. Apple TV chuyển đổi âm thanh trong khi phát; những bản không thể chuyển đổi sẽ phát như trước."
          }
        }
      }
    },
    "Lossless Surround Sound": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustfreier Surround-Klang"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonido envolvente sin pérdidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son surround sans perte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio surround lossless"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh vòm không mất dữ liệu"
          }
        }
      }
    },
    "Play TrueHD and DTS-HD Master Audio tracks without objects as lossless 5.1 or 7.1 instead of AAC 5.1.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt TrueHD- und DTS-HD-Master-Audio-Spuren ohne Objekte verlustfrei in 5.1 oder 7.1 ab statt in AAC 5.1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce las pistas TrueHD y DTS-HD Master Audio sin objetos en 5.1 o 7.1 sin pérdidas, en lugar de AAC 5.1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les pistes TrueHD et DTS-HD Master Audio sans objets en 5.1 ou 7.1 sans perte, au lieu de l’AAC 5.1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce le tracce TrueHD e DTS-HD Master Audio senza oggetti in 5.1 o 7.1 lossless invece che in AAC 5.1."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát các bản TrueHD và DTS-HD Master Audio không có đối tượng ở dạng 5.1 hoặc 7.1 không mất dữ liệu thay vì AAC 5.1."
          }
        }
      }
    },
    "These apply to the native player, from the next video. Dolby Atmos needs Audio Format on Auto and Dolby Atmos switched on in tvOS Settings → Video and Audio, and a receiver or soundbar that plays Atmos from Apple TV.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen gelten für den nativen Player, ab dem nächsten Video. Für Dolby Atmos muss in tvOS-Einstellungen → Video und Audio das Audioformat auf Automatisch stehen und Dolby Atmos eingeschaltet sein, außerdem ein Receiver oder eine Soundbar, die Atmos von der Apple TV wiedergibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplican al reproductor nativo, desde el siguiente vídeo. Dolby Atmos requiere que Formato de audio esté en Automático y Dolby Atmos activado en Configuración de tvOS → Vídeo y audio, y un receptor o barra de sonido que reproduzca Atmos desde el Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages s’appliquent au lecteur natif, dès la prochaine vidéo. Dolby Atmos nécessite que Format audio soit sur Auto et que Dolby Atmos soit activé dans Réglages tvOS → Vidéo et audio, ainsi qu’un récepteur ou une barre de son qui lit l’Atmos depuis l’Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgono per il player nativo, dal prossimo video. Dolby Atmos richiede Formato audio su Auto e Dolby Atmos attivo in Impostazioni tvOS → Video e audio, oltre a un ricevitore o una soundbar che riproduca Atmos dall’Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho trình phát gốc, từ video tiếp theo. Dolby Atmos cần đặt Định dạng âm thanh ở Tự động và bật Dolby Atmos trong Cài đặt tvOS → Video và Âm thanh, cùng bộ thu hoặc loa thanh phát được Atmos từ Apple TV."
          }
        }
      }
    },
    "Dolby Atmos via APAC 7.1.4 (from %@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos über APAC 7.1.4 (aus %@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos mediante APAC 7.1.4 (desde %@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos via APAC 7.1.4 (depuis %@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos tramite APAC 7.1.4 (da %@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Atmos qua APAC 7.1.4 (từ %@)"
          }
        }
      }
    },
    "%@ · lossless from %@": {
      "localizations": {
        "de": {
          "stringUnit": {
