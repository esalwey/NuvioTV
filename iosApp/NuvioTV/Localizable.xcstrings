    "Enter the backend URL from your server administrator. Nuvio reads /.well-known/nuvio on that server to discover its settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Backend-URL ein, die du von deinem Server-Administrator erhalten hast. Nuvio liest /.well-known/nuvio auf diesem Server, um dessen Einstellungen zu ermitteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la URL del backend que te haya dado el administrador de tu servidor. Nuvio lee /.well-known/nuvio en ese servidor para descubrir su configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’URL du backend fournie par l’administrateur de votre serveur. Nuvio lit /.well-known/nuvio sur ce serveur pour découvrir ses paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci l’URL del backend fornito dall’amministratore del server. Nuvio legge /.well-known/nuvio su quel server per rilevarne le impostazioni."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập URL backend do quản trị viên máy chủ của bạn cung cấp. Nuvio đọc /.well-known/nuvio trên máy chủ đó để khám phá cài đặt của nó."
          }
        }
      }
    },
