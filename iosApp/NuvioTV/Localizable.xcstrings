          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếng Nhật"
          }
        }
      }
    },
    "JS plugin providers add extra stream sources. Install a repository by its manifest URL or its short code — it syncs to your other Nuvio devices automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JS-Plugin-Anbieter fügen zusätzliche Stream-Quellen hinzu. Installiere ein Repository über seine Manifest-URL oder seinen Kurzcode – es wird automatisch mit deinen anderen Nuvio-Geräten synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proveedores de plugins JS añaden más fuentes de streams. Instala un repositorio con la URL de su manifiesto o con su código corto; se sincroniza automáticamente con tus otros dispositivos Nuvio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fournisseurs de plugins JS ajoutent des sources de streams supplémentaires. Installez un dépôt avec l’URL de son manifeste ou son code court ; il se synchronise automatiquement avec vos autres appareils Nuvio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fornitori di plugin JS aggiungono altre sorgenti di flussi. Installa un repository tramite l’URL del manifest o il codice breve: si sincronizza automaticamente con gli altri tuoi dispositivi Nuvio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp plugin JS thêm nguồn luồng. Cài kho bằng URL manifest hoặc mã ngắn — kho tự đồng bộ sang các thiết bị Nuvio khác của bạn."
          }
        }
      }
    },
