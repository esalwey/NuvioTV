        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Als Nächstes“ wählt nur Streams von aktivierten Plugins. Mindestens eines bleibt aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente solo elige un stream de los plugins que están activados. Siempre queda al menos uno activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À suivre » ne choisit un stream que parmi les plugins activés. Au moins un reste activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prossimo episodio sceglie un flusso solo dai plugin attivati. Almeno uno resta attivo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp theo chỉ chọn luồng từ các plugin đang bật. Luôn bật ít nhất một mục."
          }
        }
      }
    },
    "settings.binge.fallback": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Fall Back to Any Source"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf beliebige Quelle zurückgreifen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurrir a cualquier fuente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rabattre sur n’importe quelle source"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripiega su qualsiasi sorgente"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự phòng bằng nguồn bất kỳ"
          }
        }
      }
    },
    "settings.binge.fallback.subtitle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When that group has nothing for the next episode, pick another stream. Off: Up Next stops and offers the source list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Gruppe für die nächste Episode nichts hat, wird ein anderer Stream gewählt. Aus: „Als Nächstes“ stoppt und zeigt die Quellenliste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando ese grupo no tiene nada para el siguiente episodio, elige otro stream. Desactivado: Siguiente se detiene y ofrece la lista de fuentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand ce groupe n’a rien pour l’épisode suivant, choisit un autre stream. Désactivé : « À suivre » s’arrête et propose la liste des sources."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando quel gruppo non ha nulla per il prossimo episodio, sceglie un altro flusso. Se disattivato, Prossimo episodio si ferma e propone l’elenco delle sorgenti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nhóm đó không có gì cho tập tiếp theo, chọn một luồng khác. Tắt: Tiếp theo dừng lại và hiện danh sách nguồn."
          }
        }
      }
    },
    "settings.binge.prefer": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Prefer the Same Source Group"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Quellengruppe bevorzugen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferir el mismo grupo de fuentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégier le même groupe de sources"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisci lo stesso gruppo di sorgenti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ưu tiên cùng nhóm nguồn"
          }
        }
      }
    },
    "settings.binge.prefer.subtitle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Up Next first looks for the group of streams the episode you watched came from (same add-on, same quality), before the rules above."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Als Nächstes“ sucht zuerst die Gruppe von Streams, aus der die gesehene Episode stammt (dasselbe Add-on, dieselbe Qualität), noch vor den obigen Regeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente busca primero el grupo de streams del que procede el episodio que has visto (mismo complemento, misma calidad), antes de aplicar las reglas anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À suivre » cherche d’abord le groupe de streams dont provient l’épisode regardé (même add-on, même qualité), avant les règles ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prossimo episodio cerca prima il gruppo di flussi da cui proviene l’episodio che hai guardato (stesso addon, stessa qualità), prima delle regole sopra."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp theo trước tiên tìm nhóm luồng mà tập bạn vừa xem đến từ đó (cùng addon, cùng chất lượng), trước các quy tắc ở trên."
          }
        }
      }
    },
    "settings.binge.remember": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Remember the Source Group"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellengruppe merken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordar el grupo de fuentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoriser le groupe de sources"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricorda il gruppo di sorgenti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhớ nhóm nguồn"
          }
        }
      }
    },
    "settings.binge.remember.subtitle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Keep each series' source group between viewings, so Up Next still follows it after you resume from Continue Watching."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte die Quellengruppe jeder Serie zwischen den Wiedergaben, damit „Als Nächstes“ ihr auch nach dem Fortsetzen über „Weiterschauen“ folgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva el grupo de fuentes de cada serie entre sesiones, para que Siguiente lo siga usando después de reanudar desde Seguir viendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le groupe de sources de chaque série entre les visionnages, pour que « À suivre » le suive encore après une reprise depuis Continuer à regarder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene il gruppo di sorgenti di ogni serie tra una visione e l’altra, così Prossimo episodio lo segue anche dopo che riprendi da Continua a guardare."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nhóm nguồn của từng bộ phim giữa các lần xem, để Tiếp theo vẫn theo nhóm đó sau khi bạn tiếp tục từ Tiếp tục xem."
          }
        }
      }
    },
    "settings.developer.player.darkGlass": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Dark Player Glass"
