    "settings.streams.explanation": {
      "comment": "Explanation at the top of the Stream Recommendations settings section",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The source list reads each stream's title (languages, quality, HDR, audio, size) and puts the best match for you first, marked Recommended. VFF is French from France, VFQ French from Québec, VF French without a stated version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des sources lit le titre de chaque source (langues, qualité, HDR, audio, taille) et place en premier celle qui vous convient le mieux, marquée Recommandé. VFF : doublage français de France, VFQ : doublage québécois, VF : français sans version précisée."
          }
        }
      }
    },
