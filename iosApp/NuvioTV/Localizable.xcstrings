    "Local data on this Apple TV will be cleared. Your synced data stays in your Nuvio account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Daten auf diesem Apple TV werden gelöscht. Deine synchronisierten Daten bleiben in deinem Nuvio-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos locales en este Apple TV se borrarán. Tus datos sincronizados permanecen en tu cuenta de Nuvio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données locales de cette Apple TV seront effacées. Vos données synchronisées restent dans votre compte Nuvio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati locali su questo Apple TV verranno cancellati. I tuoi dati sincronizzati rimangono nel tuo account Nuvio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu cục bộ trên Apple TV này sẽ bị xóa. Dữ liệu đã đồng bộ vẫn còn trong tài khoản Nuvio của bạn."
          }
        }
      }
    },
