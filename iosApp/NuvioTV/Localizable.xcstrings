    "Removes cached Continue Watching data and refreshes your watch progress. Your history is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt zwischengespeicherte Daten von „Weiterschauen“ und aktualisiert deinen Wiedergabefortschritt. Dein Verlauf bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los datos en caché de Seguir viendo y actualiza tu progreso de visionado. Se conserva tu historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les données en cache de Continuer à regarder et actualise votre progression. Votre historique est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove i dati in cache di Continua a guardare e aggiorna i tuoi progressi di visione. La cronologia viene mantenuta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa dữ liệu Tiếp tục xem đã lưu và làm mới tiến độ xem. Lịch sử của bạn được giữ nguyên."
          }
        }
      }
    },
    "Removes this provider's key from this profile. Streams will no longer resolve through it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt den Schlüssel dieses Anbieters aus diesem Profil. Streams werden nicht mehr dadurch aufgelöst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la clave de este proveedor de este perfil. Los streams ya no se resolverán a través de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la clé de ce fournisseur pour ce profil. Les streams ne seront plus résolus via celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove la chiave di questo fornitore da questo profilo. I flussi non si risolveranno più attraverso di essa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa key của nhà cung cấp này khỏi hồ sơ. Luồng sẽ không còn phân giải qua đó."
          }
        }
      }
    },
    "Removing “%@” from %@ will also clear its %@ there. This can’t be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du „%@“ aus %@ entfernst, wird dort auch Folgendes gelöscht: %@. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eliminas “%@” de %@, también se borrará su %@ en ese servicio. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer « %@ » de %@ effacera aussi %@ à cet endroit. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovendo “%@” da %@ verrà cancellata anche la relativa %@. L’operazione non può essere annullata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xóa “%@” khỏi %@ cũng sẽ xóa %@ tại đó. Không thể hoàn tác."
          }
        }
      }
    },
