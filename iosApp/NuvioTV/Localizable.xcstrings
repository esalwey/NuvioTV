            "state": "translated",
            "value": "Listet zu Beginn eines Videos kurz die Inhaltshinweise auf, sofern der Titel welche hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera brevemente las advertencias de contenido al inicio de un vídeo, si el título las tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste brièvement les avertissements sur le contenu au début d’une vidéo, quand le titre en comporte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
