    "Continue Watching reloads its artwork and next episodes. Watch progress and history are not affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Weiterschauen“ lädt Artwork und nächste Episoden neu. Wiedergabefortschritt und Verlauf sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir viendo vuelve a cargar sus imágenes y los siguientes episodios. El progreso de visionado y el historial no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer à regarder recharge ses visuels et les épisodes suivants. La progression et l’historique ne sont pas affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a guardare ricarica le illustrazioni e i prossimi episodi. I progressi di visione e la cronologia non vengono modificati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục xem sẽ tải lại ảnh và các tập tiếp theo. Tiến độ xem và lịch sử không bị ảnh hưởng."
          }
        }
      }
    },
