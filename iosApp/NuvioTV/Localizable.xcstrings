        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Outline color and width apply to the mpv player. The native player draws the system caption edge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konturfarbe und -breite gelten für den mpv-Player. Der native Player zeichnet den System-Untertitelrand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color y el grosor del contorno se aplican al reproductor mpv. El reproductor nativo dibuja el borde de subtítulos del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
