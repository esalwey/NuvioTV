          }
        }
      }
    },
    "On · Search shows only the search field and recent searches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · Die Suche zeigt nur das Suchfeld und die letzten Suchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado · La búsqueda muestra solo el campo de búsqueda y las búsquedas recientes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · La recherche n’affiche que le champ de recherche et les recherches récentes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato · La ricerca mostra solo il campo di ricerca e le ricerche recenti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật · Tìm kiếm chỉ hiển thị ô tìm kiếm và các tìm kiếm gần đây"
          }
        }
      }
    },
    "On · Show the title's poster on the right side of detail pages": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · Zeigt das Poster des Titels auf der rechten Seite der Detailseite"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado · muestra el póster del título en el lado derecho de la página de detalles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · montre l’affiche du titre sur le côté droit de la page de détail"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "On · mostra il poster del titolo sul lato destro della pagina dei dettagli"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật · Hiện poster của phim ở bên phải trang chi tiết"
          }
        }
      }
    },
    "On · TMDB air dates override add-on release dates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · TMDB-Ausstrahlungsdaten überschreiben Add-on-Veröffentlichungsdaten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado · Las fechas de aire TMDB anulan las fechas de lanzamiento del complemento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · les dates de diffusion TMDB remplacent les dates de sortie des add-ons"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "On · le date di trasmissione TMDB sostituiscono le date di rilascio dei componenti aggiuntivi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật · Ngày chiếu TMDB thay cho ngày phát hành của addon"
          }
        }
      }
    },
    "On · The hero plays a muted trailer preview after a moment of focus on a poster": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · Der Hero spielt eine stumme Trailer-Vorschau, nachdem ein Poster kurz fokussiert wurde"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado · El hero reproduce una vista previa del tráiler sin sonido tras un momento de foco en un póster"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · Le Hero lit un aperçu muet de la bande-annonce après un instant de focus sur une affiche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo · L'hero riproduce un'anteprima muta del trailer dopo un momento di focus su un poster"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật · Hero phát bản xem trước trailer không tiếng sau một lúc tập trung vào poster"
          }
        }
      }
    },
    "On · The hero plays its trailer by itself, without waiting for focus": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
