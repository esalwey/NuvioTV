    "Sync didn't complete. Try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung wurde nicht abgeschlossen. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización no se completó. Inténtalo de nuevo."
          }
        },
