    "Only show results that match at least one selected value. Leave all off to allow everything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Ergebnisse zeigen, die mindestens einem ausgewählten Wert entsprechen. Lass alle aus, um alles zuzulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra solo los resultados que coinciden con al menos un valor seleccionado. Deja todo desactivado para permitirlo todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
