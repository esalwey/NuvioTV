            "state": "translated",
            "value": "Activado · Inicio se abre con un banner rotativo creado a partir de hasta 2 de tus catálogos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · l’accueil s’ouvre avec une bannière rotative composée d’un maximum de 2 de vos catalogues"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "On · Home si apre con un banner rotante creato da un massimo di 2 dei tuoi cataloghi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
