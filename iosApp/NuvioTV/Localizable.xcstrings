    "Relaunch, wait 90 seconds without touching the remote, then photograph this pane.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu starten, 90 Sekunden lang die Fernbedienung nicht berühren, dann dieses Fenster fotografieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia, espera 90 segundos sin tocar el mando y luego fotografía esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez, attendez 90 secondes sans toucher la télécommande, puis photographiez cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
