    "%@ didn't accept this key. Check it and try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté cette clé. Vérifiez-la et réessayez."
          }
        }
      }
    },
    "%@ f=%lld t=%lld y=%lld i=%lld r=%lld": {
      "shouldTranslate": false
    },
    "%@ has no device sign-in here: paste the API key from your %@ account. It resolves the links of add-ons that hand them to %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas de connexion par code ici : collez la clé API de votre compte %@. Elle résout les liens des add-ons qui les confient à %@."
          }
        }
      }
    },
    "%@ now uses the settings of %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet jetzt die Einstellungen von %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ahora usa los ajustes de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise désormais les réglages de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora usa le impostazioni di %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ giờ dùng cài đặt của %@."
          }
        }
      }
    },
    "%@ of the episode": {
      "localizations": {
