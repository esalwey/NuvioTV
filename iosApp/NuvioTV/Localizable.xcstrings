    "settings.lastLink.footer": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Links from debrid services expire sooner and are only replayed within 15 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links von Debrid-Diensten laufen früher ab und werden nur innerhalb von 15 Minuten erneut abgespielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de servicios debrid caducan antes y solo se reutilizan durante 15 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens des services debrid expirent plus vite et ne sont relus que dans les 15 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link dei servizi debrid scadono prima e vengono riprodotti di nuovo solo entro 15 minuti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết từ dịch vụ debrid hết hạn sớm hơn và chỉ được phát lại trong 15 phút."
          }
        }
      }
    },
    "settings.lastLink.reuse": {
