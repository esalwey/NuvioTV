    "Found %lld %@, but none could be resolved to a playable link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefunden %lld %@, aber keines konnte in einen abspielbar Stream-Link aufgelöst werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron %lld %@, pero ninguno pudo resolverse en un enlace reproducible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg stream trouvé, mais il n’a pas pu être résolu en lien lisible."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg streams trouvés, mais aucun n’a pu être résolu en lien lisible."
                    }
                  }
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovato %lld %@, ma nessuno potrebbe essere risolto in un collegamento riproducibile."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm thấy %lld %@, nhưng không phân giải được liên kết phát nào."
          }
        }
      }
    },
