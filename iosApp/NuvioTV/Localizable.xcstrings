    "After a show, continue from the episode you watched last, for rewatches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer Serie geht es ab der zuletzt gesehenen Episode weiter, praktisch beim erneuten Anschauen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras una serie, continúa desde el último episodio que viste, útil para volver a verla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une série, continue depuis le dernier épisode que vous avez regardé, pour les revisionnages"
