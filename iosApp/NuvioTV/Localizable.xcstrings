    "Controls how result names appear. Leave blank to use the original result name. Saved when you leave this screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wie Ergebnisnamen erscheinen. Lass das Feld leer, um den ursprünglichen Ergebnisnamen zu verwenden. Wird beim Verlassen dieses Bildschirms gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cómo aparecen los nombres de los resultados. Déjalo en blanco para usar el nombre original. Se guarda al salir de esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit l’affichage du nom des résultats. Laissez vide pour utiliser le nom d’origine. Enregistré à la fermeture de cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla come appaiono i nomi dei risultati. Lascia vuoto per usare il nome originale del risultato. Salvato quando esci da questa schermata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy định cách hiện tên kết quả. Để trống để dùng tên kết quả gốc. Được lưu khi bạn rời màn hình này."
          }
        }
      }
    },
    "Controls the metadata shown under each result. Leave blank to use the original result details. Saved when you leave this screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, welche Metadaten unter jedem Ergebnis stehen. Lass das Feld leer, um die ursprünglichen Ergebnisdetails zu verwenden. Wird beim Verlassen dieses Bildschirms gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla los metadatos que se muestran bajo cada resultado. Déjalo en blanco para usar los detalles originales. Se guarda al salir de esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit les métadonnées affichées sous chaque résultat. Laissez vide pour utiliser les détails d’origine. Enregistré à la fermeture de cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i metadati mostrati sotto ogni risultato. Lascia vuoto per usare i dettagli originali del risultato. Salvato quando esci da questa schermata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy định siêu dữ liệu hiện dưới mỗi kết quả. Để trống để dùng chi tiết kết quả gốc. Được lưu khi bạn rời màn hình này."
          }
        }
      }
    },
