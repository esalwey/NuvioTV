    "Show a spinner while a video opens. When off, the screen stays black until the first frame.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen Spinner an, während ein Video geöffnet wird. Wenn aus, bleibt der Bildschirm bis zum ersten Bild schwarz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un indicador de actividad mientras se abre un vídeo. Si está desactivado, la pantalla permanece en negro hasta el primer fotograma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un indicateur pendant l’ouverture d’une vidéo. Désactivé, l’écran reste noir jusqu’à la première image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un indicatore di avanzamento mentre si apre un video. Se disattivato, lo schermo resta nero fino al primo fotogramma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện vòng xoay khi video đang mở. Khi tắt, màn hình đen cho đến khi có khung hình đầu tiên."
          }
        }
      }
    },
