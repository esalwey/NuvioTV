    "Simkl isn't configured in this build. Add SIMKL_CLIENT_ID to local.properties, then rebuild the shared framework.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simkl ist in diesem Build nicht konfiguriert. Füge SIMKL_CLIENT_ID zu local.properties hinzu und baue dann das Shared Framework neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simkl no está configurado en esta build. Añade SIMKL_CLIENT_ID a local.properties y recompila el framework compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simkl n’est pas configuré dans ce build. Ajoutez SIMKL_CLIENT_ID à local.properties, puis recompilez le framework partagé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simkl non è configurato in questa build. Aggiungi SIMKL_CLIENT_ID a local.properties, poi ricompila il framework condiviso."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Simkl chưa được cấu hình trong bản dựng này. Thêm SIMKL_CLIENT_ID vào local.properties, rồi build lại framework chia sẻ."
          }
        }
      }
    },
