          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato · Contatori di geometria di scorrimento e push/pop qui sotto — fotografa dopo il test"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
