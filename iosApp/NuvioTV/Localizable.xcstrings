    },
    "Press and hold a section to move it up or down. Actions and Overview stay at the top of the page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Bereich gedrückt, um ihn nach oben oder unten zu verschieben. „Aktionen“ und „Übersicht“ bleiben oben auf der Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una sección para subirla o bajarla. Acciones y Resumen permanecen en la parte superior de la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une section enfoncée pour la monter ou la descendre. Les actions et le résumé restent en haut de la page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto su una sezione per spostarla su o giù. Azioni e Panoramica restano in cima alla pagina."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn và giữ một phần để chuyển lên hoặc xuống. Hành động và Tổng quan luôn ở đầu trang."
          }
        }
      }
    },
