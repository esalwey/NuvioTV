    },
    "Streaming Buffer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming-Puffer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búfer de streaming"
          }
        },
