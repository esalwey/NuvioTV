    },
    "Sync your library, watch progress, and profiles across devices. Local guest data on this Apple TV will be cleared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere deine Mediathek, deinen Ansichtsverlauf und deine Profile auf allen Geräten. Lokale Gastdaten auf diesem Apple TV werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tu biblioteca, progreso de visualización y perfiles en dispositivos. Los datos de invitado locales en este Apple TV se borrarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez votre bibliothèque, votre progression et vos profils entre appareils. Les données invité locales de cette Apple TV seront effacées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza la tua libreria, il progresso di visione e i profili su tutti i dispositivi. I dati guest locali su questo Apple TV verranno cancellati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ thư viện, tiến độ xem và hồ sơ giữa các thiết bị. Dữ liệu khách cục bộ trên Apple TV này sẽ bị xóa."
          }
        }
      }
    },
    "Sync your watched history, resume points and lists with your MDBList account (movies and episodes are marked watched automatically).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere deinen Wiedergabeverlauf, Fortsetzungspunkte und Listen mit deinem MDBList-Konto (Filme und Episoden werden automatisch als gesehen markiert)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tu historial de visionado, puntos de reanudación y listas con tu cuenta de MDBList (las películas y los episodios se marcan como vistos automáticamente)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez votre historique de visionnage, vos points de reprise et vos listes avec votre compte MDBList (les films et épisodes sont marqués comme vus automatiquement)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza la cronologia di visione, i punti di ripresa e le liste con il tuo account MDBList (i film e gli episodi sono contrassegnati come guardati automaticamente)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ lịch sử đã xem, điểm tiếp tục và danh sách với tài khoản MDBList của bạn (phim và tập được đánh dấu đã xem tự động)."
          }
        }
      }
    },
