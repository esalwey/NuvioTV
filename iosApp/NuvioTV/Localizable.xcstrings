    "Scan a QR code to sign in — no typing required": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne einen QR-Code zum Anmelden – kein Tippen erforderlich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea un código QR para iniciar sesión — sin escritura requerida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez un code QR pour vous connecter — aucune saisie nécessaire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona un codice QR per accedere — nessuna digitazione richiesta"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã QR để đăng nhập — không cần gõ"
          }
        }
      }
    },
    "Scan the QR code with your phone's camera and approve the sign-in — no typing on the TV.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den QR-Code mit der Kamera deines Phones und genehmige die Anmeldung – kein Tippen auf dem TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR con la cámara de tu teléfono y aprueba el inicio de sesión — sin escritura en el televisor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code QR avec l’appareil photo de votre téléphone et approuvez la connexion — aucune saisie sur la TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice QR con la fotocamera del tuo telefono e approva l'accesso — nessuna digitazione sulla TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã QR bằng camera điện thoại và duyệt đăng nhập — không cần gõ trên TV."
          }
        }
      }
    },
    "Scan the code, or open in any browser:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code, oder öffne in einem beliebigen Browser:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código u abre en cualquier navegador:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code, ou ouvrez-le dans un navigateur :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice o aprilo in qualsiasi browser:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã, hoặc mở trong trình duyệt bất kỳ:"
          }
        }
      }
    },
    "Scrobble what you watch on this Apple TV to your Trakt profile (movies and episodes are marked watched automatically).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende, was du auf diesem Apple TV schaust, an dein Trakt-Profil (Filme und Episoden werden automatisch als gesehen markiert)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra lo que ves en este Apple TV en tu perfil de Trakt (películas y episodios se marcan como vistos automáticamente)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le scrobbling de ce que vous regardez sur cette Apple TV vers votre profil Trakt (les films et épisodes sont marqués comme vus automatiquement)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobble quello che guardi su questo Apple TV nel tuo profilo Trakt (i film e gli episodi sono contrassegnati come guardati automaticamente)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi những gì bạn xem trên Apple TV này vào hồ sơ Trakt (phim và tập được đánh dấu đã xem tự động)."
          }
        }
      }
    },
    "Scrobbling stops and this Apple TV's Simkl authorization is cleared. Your Simkl history is untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Scrobbling stoppt und die Simkl-Autorisierung dieses Apple TV wird gelöscht. Dein Simkl-Verlauf bleibt unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El scrobbling se detiene y se borra la autorización de Simkl de este Apple TV. Tu historial de Simkl no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scrobbling s’arrête et l’autorisation Simkl de cette Apple TV est effacée. Votre historique Simkl reste intact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scrobbling si interrompe e l'autorizzazione Simkl di questa Apple TV viene rimossa. La tua cronologia Simkl resta intatta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobble sẽ dừng và quyền Simkl của Apple TV này bị xóa. Lịch sử Simkl của bạn không bị ảnh hưởng."
          }
        }
      }
    },
    "Scrobbling stops and this Apple TV's Trakt access token is revoked. Your Trakt history is untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobbling stoppt und das Trakt-Zugriffstoken dieses Apple TV wird widerrufen. Dein Trakt-Verlauf bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro se detiene y se revoca el token de acceso de Trakt de este Apple TV. Tu historial de Trakt no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scrobbling s’arrête et le jeton d’accès Trakt de cette Apple TV est révoqué. Votre historique Trakt reste intact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scrobbling si interrompe e il token di accesso Trakt di questo Apple TV viene revocato. La tua cronologia Trakt rimane intatta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrobble sẽ dừng và token Trakt của Apple TV này bị thu hồi. Lịch sử Trakt của bạn không bị ảnh hưởng."
          }
        }
      }
    },
