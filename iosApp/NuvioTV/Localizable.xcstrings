    "Blend frames to match the display's refresh rate for steadier pans. Films can look less cinematic.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mischt Bilder passend zur Bildwiederholrate des Displays für ruhigere Schwenks. Filme können weniger kinoartig wirken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezcla fotogramas para ajustarse a la frecuencia de actualización de la pantalla y lograr panorámicas más estables. Las películas pueden parecer menos cinematográficas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélange les images pour correspondre à la fréquence de rafraîchissement de l’écran et rendre les panoramiques plus stables. Les films peuvent paraître moins cinématographiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonde i fotogrammi per adattarsi alla frequenza di aggiornamento del display, per panoramiche più stabili. I film possono sembrare meno cinematografici."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trộn khung hình để khớp tần số quét của màn hình, giúp lia máy ổn định hơn. Phim có thể kém chất điện ảnh."
          }
        }
      }
    },
