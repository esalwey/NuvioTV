    "Ratings appear on a title's Details in this order. Select a provider to move it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertungen erscheinen in dieser Reihenfolge in den Details eines Titels. Wähle einen Anbieter, um ihn zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las valoraciones aparecen en los detalles de un título en este orden. Selecciona un proveedor para moverlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes apparaissent dans les détails d’un titre dans cet ordre. Sélectionnez un fournisseur pour le déplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I voti compaiono nei dettagli di un titolo in questo ordine. Seleziona un fornitore per spostarlo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm đánh giá hiện trong Thông tin của phim theo thứ tự này. Chọn một nhà cung cấp để di chuyển."
          }
        }
      }
    },
    "Ratings from switched-off providers are not shown.": {
      "localizations": {
