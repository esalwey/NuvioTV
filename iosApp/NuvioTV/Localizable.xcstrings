    "Enter TMDB IDs. Separate multiple IDs with commas for AND, or pipes for OR. Quick chips toggle common IDs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib TMDB-IDs ein. Trenne mehrere IDs mit Kommas für UND oder mit senkrechten Strichen für ODER. Die Schnellauswahl-Chips schalten gängige IDs um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce IDs de TMDB. Separa varios IDs con comas para Y (AND) o con barras verticales para O (OR). Los chips rápidos activan o desactivan IDs habituales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez des identifiants TMDB. Séparez plusieurs identifiants par des virgules pour ET, ou par des barres verticales pour OU. Les puces rapides activent ou désactivent les identifiants courants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci gli ID TMDB. Separa più ID con virgole per AND o con barre verticali per OR. I chip rapidi attivano o disattivano gli ID più comuni."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập ID TMDB. Phân tách nhiều ID bằng dấu phẩy cho AND, hoặc dấu gạch đứng cho OR. Các thẻ nhanh bật/tắt những ID phổ biến."
          }
        }
      }
    },
    "Enter a valid HTTP or HTTPS backend URL.": {
      "localizations": {
