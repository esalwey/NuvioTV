    "settings.timeout.subtitle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "How long Up Next waits for add-ons before it chooses a stream. Instant chooses as soon as a suitable one arrives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange „Als Nächstes“ auf Add-ons wartet, bevor ein Stream gewählt wird. „Sofort“ wählt, sobald ein passender eintrifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto espera Siguiente a los complementos antes de elegir un stream. Al instante elige en cuanto llega uno adecuado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle « À suivre » attend les add-ons avant de choisir un stream. Instantané choisit dès qu’un stream adapté arrive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo Prossimo episodio attende gli addon prima di scegliere un flusso. «Istantaneo» sceglie non appena ne arriva uno adatto."
          }
        },
        "vi": {
          "stringUnit": {
