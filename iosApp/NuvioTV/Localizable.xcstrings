    "Point this Apple TV at a self-hosted Nuvio backend. Switching servers signs you out and clears local data on this Apple TV.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dieses Apple TV mit einem selbst gehosteten Nuvio-Backend. Beim Serverwechsel wirst du abgemeldet und lokale Daten auf diesem Apple TV werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta este Apple TV a un backend de Nuvio autoalojado. Cambiar de servidor cierra tu sesión y borra los datos locales en este Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez cette Apple TV à un backend Nuvio auto-hébergé. Changer de serveur vous déconnecte et efface les données locales de cette Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega questo Apple TV a un backend Nuvio self-hosted. Cambiare server ti disconnette e cancella i dati locali su questo Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trỏ Apple TV này đến một backend Nuvio tự lưu trữ. Việc chuyển máy chủ sẽ đăng xuất bạn và xóa dữ liệu cục bộ trên Apple TV này."
          }
        }
      }
    },
