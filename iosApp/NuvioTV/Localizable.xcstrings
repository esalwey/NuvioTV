    "Ratings use your connected MDBList account again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertungen nutzen wieder dein verbundenes MDBList-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las valoraciones vuelven a usar tu cuenta de MDBList conectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes utilisent à nouveau votre compte MDBList connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le valutazioni usano di nuovo il tuo account MDBList connesso."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm đánh giá lại dùng tài khoản MDBList đã kết nối của bạn."
          }
        }
      }
    },
    "Ratings use your connected MDBList account to show IMDb, TMDB, Rotten Tomatoes, Audience Score, Metacritic, Trakt, Letterboxd and MyAnimeList scores in a title's Details. An API key overrides the account; remove it to use the account again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertungen nutzen dein verbundenes MDBList-Konto, um IMDb-, TMDB-, Rotten-Tomatoes-, Publikums-, Metacritic-, Trakt-, Letterboxd- und MyAnimeList-Bewertungen in den Details eines Titels anzuzeigen. Ein API-Schlüssel hat Vorrang vor dem Konto; entferne ihn, um wieder das Konto zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las valoraciones usan tu cuenta de MDBList conectada para mostrar las puntuaciones de IMDb, TMDB, Rotten Tomatoes, Audience Score, Metacritic, Trakt, Letterboxd y MyAnimeList en los detalles de un título. Una clave API tiene prioridad sobre la cuenta; elimínala para volver a usar la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes utilisent votre compte MDBList connecté pour afficher les notes IMDb, TMDB, Rotten Tomatoes, Audience Score, Metacritic, Trakt, Letterboxd et MyAnimeList dans les détails d’un titre. Une clé API prend le pas sur le compte \u0001 supprimez-la pour réutiliser le compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le valutazioni usano il tuo account MDBList connesso per mostrare i voti di IMDb, TMDB, Rotten Tomatoes, Audience Score, Metacritic, Trakt, Letterboxd e MyAnimeList nei dettagli del titolo. Una chiave API ha la precedenza sull’account; rimuovila per usare di nuovo l’account."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm đánh giá dùng tài khoản MDBList đã kết nối để hiện điểm IMDb, TMDB, Rotten Tomatoes, Audience Score, Metacritic, Trakt, Letterboxd và MyAnimeList trong Thông tin của phim. API key được ưu tiên hơn tài khoản; hãy xóa nó để dùng lại tài khoản."
          }
        }
      }
    },
