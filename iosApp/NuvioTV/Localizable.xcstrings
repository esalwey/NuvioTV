    "Prefer, require or hide specific resolutions, qualities, tags, languages and release groups.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmte Auflösungen, Qualitäten, Tags, Sprachen und Release-Gruppen bevorzugen, verlangen oder ausblenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza, exige u oculta resoluciones, calidades, etiquetas, idiomas y grupos de lanzamiento concretos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégiez, exigez ou masquez des résolutions, qualités, balises, langues et groupes de release précis."
