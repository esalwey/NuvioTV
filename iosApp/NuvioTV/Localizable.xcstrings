            "state": "translated",
            "value": "IntroDB hat diesen Schlüssel nicht akzeptiert oder war nicht erreichbar. Prüfe ihn und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IntroDB no ha aceptado esta clave o no se ha podido conectar. Compruébala e inténtalo de nuevo."
          }
        },
        "fr": {
