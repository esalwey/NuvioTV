    "settings.lastLink.reuse.subtitle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Continue Watching plays the source you last used for a title instead of asking again, while its link is still good."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Weiterschauen“ spielt die zuletzt für einen Titel verwendete Quelle ab, statt erneut zu fragen, solange ihr Link noch gültig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir viendo reproduce la fuente que usaste por última vez en un título en lugar de preguntar de nuevo, mientras su enlace siga siendo válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer à regarder lit la dernière source utilisée pour un titre au lieu de redemander, tant que son lien est valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
