    "Open straight into the profile you used last instead of asking who is watching. Profiles locked with a PIN always ask.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne direkt das zuletzt verwendete Profil, statt zu fragen, wer zuschaut. Mit PIN gesperrte Profile fragen immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre directamente el perfil que usaste por última vez en lugar de preguntar quién está viendo. Los perfiles bloqueados con PIN siempre preguntan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre directement le dernier profil utilisé au lieu de demander qui regarde. Les profils verrouillés par code PIN demandent toujours le code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri direttamente il profilo usato per ultimo invece di chiedere chi sta guardando. I profili bloccati da PIN lo chiedono sempre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thẳng hồ sơ bạn dùng gần nhất thay vì hỏi ai đang xem. Hồ sơ khóa bằng PIN luôn hỏi."
          }
        }
      }
    },
    "Open the title whose trailer looks zoomed, let it play 10 seconds, come back and photograph this pane.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Titel, dessen Trailer gezoomt aussieht, lass ihn 10 Sekunden laufen, komm zurück und fotografiere diesen Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el título cuyo tráiler se ve con zoom, déjalo reproducir 10 segundos, vuelve y fotografía este panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le titre dont la bande-annonce semble zoomée, laissez-la jouer 10 secondes, revenez et photographiez cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il titolo il cui trailer sembra ingrandito, lascialo riprodurre per 10 secondi, torna e fotografa questo pannello."
          }
