        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento de descubrimiento no identifica un servidor autoalojado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document de découverte n’identifie pas un serveur auto-hébergé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento di discovery non identifica un server self-hosted."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu khám phá không xác định được máy chủ tự lưu trữ."
          }
        }
      }
    },
    "The discovery document is larger than allowed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Discovery-Dokument ist größer als erlaubt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento de descubrimiento supera el tamaño permitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document de découverte dépasse la taille autorisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento di discovery supera la dimensione consentita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu khám phá lớn hơn mức cho phép."
          }
        }
      }
    },
    "The discovery document is missing a valid backend URL or publishable key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Discovery-Dokument fehlt eine gültige Backend-URL oder ein Publishable Key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al documento de descubrimiento le falta una URL de backend o una clave publicable válidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document de découverte ne contient pas d’URL de backend ou de clé publiable valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel documento di discovery manca un URL backend valido o una chiave pubblicabile."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu khám phá thiếu URL backend hoặc khóa công khai hợp lệ."
          }
        }
      }
    },
    "The discovery document is valid. Connecting signs you out of the current server and clears local data on this Apple TV. Only continue if you own or trust this server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Discovery-Dokument ist gültig. Beim Verbinden wirst du vom aktuellen Server abgemeldet und lokale Daten auf diesem Apple TV werden gelöscht. Fahre nur fort, wenn dir dieser Server gehört oder du ihm vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento de descubrimiento es válido. Al conectarte se cerrará tu sesión en el servidor actual y se borrarán los datos locales en este Apple TV. Continúa solo si este servidor es tuyo o confías en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document de découverte est valide. La connexion vous déconnecte du serveur actuel et efface les données locales de cette Apple TV. Ne continuez que si ce serveur vous appartient ou si vous lui faites confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento di discovery è valido. La connessione ti disconnette dal server corrente e cancella i dati locali su questo Apple TV. Continua solo se questo server è tuo o ti fidi di chi lo gestisce."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu khám phá hợp lệ. Việc kết nối sẽ đăng xuất bạn khỏi máy chủ hiện tại và xóa dữ liệu cục bộ trên Apple TV này. Chỉ tiếp tục nếu bạn sở hữu hoặc tin cậy máy chủ này."
          }
        }
      }
    },
    "The discovery document isn’t for Nuvio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Discovery-Dokument ist nicht für Nuvio bestimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento de descubrimiento no es para Nuvio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document de découverte n’est pas destiné à Nuvio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento di discovery non è per Nuvio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu khám phá không dành cho Nuvio."
          }
        }
      }
    },
    "The discovery endpoint returned HTTP %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Discovery-Endpunkt hat HTTP %lld zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El endpoint de descubrimiento devolvió HTTP %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de terminaison de découverte a renvoyé HTTP %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’endpoint di discovery ha restituito HTTP %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm cuối khám phá trả về HTTP %lld."
          }
        }
      }
    },
    "The file is no longer on the server (HTTP %lld).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’est plus sur le serveur (HTTP %lld)."
          }
        }
      }
    },
    "The hero plays a muted trailer preview after a moment of focus on a poster": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Hero lit un aperçu muet de la bande-annonce après un instant de focus sur une affiche"
          }
        }
      }
    },
    "The hero plays its trailer by itself, without waiting for focus": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Hero lit sa bande-annonce de lui-même, sans attendre le focus"
          }
        }
      }
    },
    "The hero shows artwork only": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Hero n’affiche que le visuel"
          }
        }
      }
    },
    "The profile changed before this sign-in finished, so the key wasn't saved. Connect again on this profile.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil a changé avant la fin de la connexion : la clé n’a pas été enregistrée. Reconnectez-vous sur ce profil."
          }
        }
      }
    },
    "The provider returned an unplayable link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat einen nicht abspielbar Link zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor devolvió un enlace no reproducible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a renvoyé un lien illisible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore ha restituito un collegamento non riproducibile."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp trả về liên kết không phát được."
          }
        }
      }
    },
    "The quick brown fox": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "The quick brown fox"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rápido zorro marrón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez ce vieux whisky au juge blond qui fume"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La veloce volpe marrone"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cáo nâu nhanh nhẹn"
          }
        }
      }
    },
    "The server answered with an error (HTTP %lld).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu par une erreur (HTTP %lld)."
          }
        }
      }
    },
    "The server doesn’t advertise a sign-in method this Apple TV supports (email & password or QR sign-in).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server bietet keine Anmeldemethode an, die dieses Apple TV unterstützt (E-Mail & Passwort oder QR-Anmeldung)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no anuncia ningún método de inicio de sesión compatible con este Apple TV (correo y contraseña o inicio de sesión con QR)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’annonce aucune méthode de connexion prise en charge par cette Apple TV (e-mail et mot de passe ou connexion par QR)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non dichiara un metodo di accesso supportato da questo Apple TV (email e password o accesso con QR)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ không công bố phương thức đăng nhập nào mà Apple TV này hỗ trợ (email & mật khẩu hoặc đăng nhập bằng QR)."
          }
        }
      }
    },
    "The server operator can receive your account credentials and access data you sync through this server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Serverbetreiber kann deine Anmeldedaten erhalten und auf Daten zugreifen, die du über diesen Server synchronisierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El operador del servidor puede recibir las credenciales de tu cuenta y acceder a los datos que sincronices a través de este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opérateur du serveur peut recevoir les identifiants de votre compte et accéder aux données que vous synchronisez via ce serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gestore del server può ricevere le credenziali del tuo account e accedere ai dati che sincronizzi tramite questo server."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người vận hành máy chủ có thể nhận được thông tin đăng nhập tài khoản của bạn và truy cập dữ liệu bạn đồng bộ qua máy chủ này."
          }
        }
      }
    },
    "The server ran into an error (HTTP %lld).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a rencontré une erreur (HTTP %lld)."
          }
        }
      }
    },
    "The server refused access (HTTP %lld). The link may have expired.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé l’accès (HTTP %lld). Le lien a peut-être expiré."
          }
        }
      }
    },
    "The server returned an invalid discovery document.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat ein ungültiges Discovery-Dokument zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor devolvió un documento de descubrimiento no válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a renvoyé un document de découverte invalide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha restituito un documento di discovery non valido."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ trả về tài liệu khám phá không hợp lệ."
          }
        }
      }
    },
    "The server was saved, but the app couldn’t restart its connection. Relaunch Nuvio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wurde gespeichert, aber die App konnte die Verbindung nicht neu starten. Starte Nuvio neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se guardó, pero la app no pudo reiniciar su conexión. Vuelve a abrir Nuvio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a été enregistré, mais l’app n’a pas pu redémarrer sa connexion. Relancez Nuvio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server è stato salvato, ma l’app non è riuscita a riavviare la connessione. Riavvia Nuvio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ đã được lưu, nhưng ứng dụng không thể khởi động lại kết nối. Hãy khởi chạy lại Nuvio."
          }
        }
      }
    },
    "The source didn’t deliver a playable video. The link may have expired, or the file may be unavailable or unsupported.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source n’a pas fourni de vidéo lisible. Le lien a peut-être expiré, ou le fichier est indisponible ou non pris en charge."
          }
        }
      }
    },
    "The source isn’t responding — it may be overloaded or offline. Playback starts on its own if it answers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source ne répond pas — elle est peut-être surchargée ou hors ligne. La lecture démarrera d’elle-même si elle répond."
          }
        }
      }
    },
    "The source played a short clip instead of the video — often a notice from the debrid service that the file isn’t ready yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source a lu un court extrait au lieu de la vidéo — souvent un avis du service debrid indiquant que le fichier n’est pas encore prêt."
          }
        }
      }
    },
    "The stream stopped before the end. The connection may have dropped, or the link may have expired. Retry picks up where it stopped.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stream s’est arrêté avant la fin. La connexion a peut-être été coupée, ou le lien a expiré. « Réessayer » reprend là où il s’est arrêté."
          }
        }
      }
    },
    "The stream stopped right after it started. The file may be incomplete, or the connection dropped.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stream s’est arrêté juste après avoir démarré. Le fichier est peut-être incomplet, ou la connexion a été coupée."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề"
          }
        }
      }
    },
    "This appears to be a private-network server, but Nuvio still cannot verify who controls it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies scheint ein Server in einem privaten Netzwerk zu sein, aber Nuvio kann trotzdem nicht überprüfen, wer ihn kontrolliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece ser un servidor de red privada, pero Nuvio sigue sin poder verificar quién lo controla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur semble être sur un réseau privé, mais Nuvio ne peut toujours pas vérifier qui le contrôle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra un server su rete privata, ma Nuvio non può comunque verificare chi lo controlla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây có vẻ là máy chủ trong mạng riêng, nhưng Nuvio vẫn không thể xác minh ai kiểm soát nó."
          }
        }
      }
    },
    "This discovery document version isn’t supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version des Discovery-Dokuments wird nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión del documento de descubrimiento no es compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version du document de découverte n’est pas prise en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione del documento di discovery non è supportata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản tài liệu khám phá này không được hỗ trợ."
          }
        }
      }
    },
    "This file isn't playable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist nicht abspielbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es reproducible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas lisible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è riproducibile."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này không phát được."
          }
        }
      }
    },
    "This link expired. Refreshing results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link ist abgelaufen. Aktualisiere Ergebnisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace expiró. Resultados refrescantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien a expiré. Actualisation des résultats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link è scaduto. Aggiornamento dei risultati in corso."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết đã hết hạn, đang làm mới"
          }
        }
      }
    },
    "This profile is locked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil ist gesperrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil está bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil est verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo profilo è bloccato."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này đã bị khóa."
          }
        }
      }
    },
    "This profile uses the add-ons of %@. To install, remove or turn off an add-on, switch to %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil utilise les add-ons de %@. Pour installer, supprimer ou désactiver un add-on, passez sur %@."
          }
        }
      }
    },
    "This profile uses the main profile’s add-ons. To install, remove or turn off an add-on, switch to the main profile.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil utilise les add-ons du profil principal. Pour installer, supprimer ou désactiver un add-on, passez sur le profil principal."
          }
        }
      }
    },
    "This profile will require the PIN to open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil erfordert die PIN zum Öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil requerirá el PIN para abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil nécessitera le code PIN pour s’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo profilo richiederà il PIN per aprirsi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này sẽ yêu cầu PIN khi mở."
          }
        }
      }
    },
    "This server is on a private network, but HTTP traffic is not encrypted. Other devices on the network may be able to read it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server befindet sich in einem privaten Netzwerk, aber der HTTP-Verkehr ist nicht verschlüsselt. Andere Geräte im Netzwerk können ihn möglicherweise mitlesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está en una red privada, pero el tráfico HTTP no está cifrado. Otros dispositivos de la red podrían leerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur est sur un réseau privé, mais le trafic HTTP n’est pas chiffré. D’autres appareils du réseau pourraient le lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server è su una rete privata, ma il traffico HTTP non è cifrato. Altri dispositivi sulla rete potrebbero leggerlo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ này nằm trong mạng riêng, nhưng lưu lượng HTTP không được mã hóa. Các thiết bị khác trong mạng có thể đọc được nó."
          }
        }
      }
    },
    "This server signs in with email and password": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verwendet die Anmeldung mit E-Mail und Passwort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor inicia sesión con correo y contraseña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur utilise la connexion par e-mail et mot de passe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server usa l’accesso con email e password"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ này đăng nhập bằng email và mật khẩu"
          }
        }
      }
    },
    "This server uses a public hostname and unencrypted HTTP. Credentials and synced data may be exposed in transit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verwendet einen öffentlichen Hostnamen und unverschlüsseltes HTTP. Anmeldedaten und synchronisierte Daten können bei der Übertragung offengelegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa un nombre de host público y HTTP sin cifrar. Las credenciales y los datos sincronizados podrían quedar expuestos en tránsito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur utilise un nom d’hôte public et du HTTP non chiffré. Les identifiants et les données synchronisées peuvent être exposés en transit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server usa un hostname pubblico e HTTP non cifrato. Le credenziali e i dati sincronizzati potrebbero essere esposti durante il transito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ này dùng tên máy chủ công khai và HTTP không mã hóa. Thông tin đăng nhập và dữ liệu đã đồng bộ có thể bị lộ trong quá trình truyền."
          }
        }
      }
    },
    "This server uses a public hostname. Nuvio cannot verify who owns or operates it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verwendet einen öffentlichen Hostnamen. Nuvio kann nicht überprüfen, wem er gehört oder wer ihn betreibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa un nombre de host público. Nuvio no puede verificar quién es su propietario ni quién lo opera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur utilise un nom d’hôte public. Nuvio ne peut pas vérifier qui le possède ou l’exploite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server usa un hostname pubblico. Nuvio non può verificare chi lo possiede o lo gestisce."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ này dùng tên máy chủ công khai. Nuvio không thể xác minh ai sở hữu hoặc vận hành nó."
          }
        }
      }
    },
    "This source can’t be edited.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Quelle kann nicht bearbeitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fuente no se puede editar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source ne peut pas être modifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fonte non può essere modificata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chỉnh sửa nguồn này."
          }
        }
      }
    },
    "This source is pinned to its TMDB company or network; these filters narrow it further.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Quelle ist an ihre TMDB-Firma oder ihren TMDB-Sender gebunden; diese Filter grenzen sie weiter ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fuente está fijada a su compañía o cadena de TMDB; estos filtros la acotan aún más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source est liée à sa société ou à son réseau TMDB ; ces filtres l’affinent davantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fonte è vincolata alla sua società o network TMDB; questi filtri la restringono ulteriormente."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn này được ghim vào công ty hoặc mạng TMDB của nó; các bộ lọc này sẽ thu hẹp thêm."
          }
        }
      }
    },
    "This source needs request headers that external players can’t send — it may not play there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source exige des en-têtes HTTP que les lecteurs externes ne peuvent pas transmettre — elle risque de ne pas être lue."
          }
        }
      }
    },
    "This source needs request headers that external players can’t send — playing in NuvioTV.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source exige des en-têtes HTTP que les lecteurs externes ne peuvent pas transmettre — lecture dans NuvioTV."
          }
        }
      }
    },
