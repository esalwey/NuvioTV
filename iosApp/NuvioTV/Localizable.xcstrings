    "Your MDBList connection has expired or been revoked. Connect again to resume syncing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine MDBList-Verbindung ist abgelaufen oder wurde widerrufen. Verbinde dich erneut, um die Synchronisierung fortzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conexión con MDBList ha caducado o se ha revocado. Vuelve a conectar para reanudar la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion MDBList a expiré ou a été révoquée. Reconnectez-vous pour reprendre la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua connessione a MDBList è scaduta o è stata revocata. Riconnetti per riprendere la sincronizzazione."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối MDBList của bạn đã hết hạn hoặc bị thu hồi. Hãy kết nối lại để tiếp tục đồng bộ."
          }
        }
      }
    },
    "Your Sync Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Sync-Code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu código de sincronización"
          }
        },
        "fr": {
