          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les notes affichées sur un titre et leur ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali voti compaiono su un titolo e in quale ordine."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn điểm nào hiện trên phim và theo thứ tự nào."
          }
        }
      }
    },
    "Choose your own accent color": {
