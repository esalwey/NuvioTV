    "Wrap a placeholder in braces, for example {stream.resolution}. Add a condition for fallbacks: {stream.resolution::exists[\"{stream.resolution} \"||\"\"]}.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze einen Platzhalter in geschweifte Klammern, z. B. {stream.resolution}. Füge für Fallbacks eine Bedingung hinzu: {stream.resolution::exists[\"{stream.resolution} \"||\"\"]}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encierra un marcador de posición entre llaves, por ejemplo {stream.resolution}. Añade una condición para valores alternativos: {stream.resolution::exists[\"{stream.resolution} \"||\"\"]}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez une variable entre accolades, par exemple {stream.resolution}. Ajoutez une condition pour une valeur de repli : {stream.resolution::exists[\"{stream.resolution} \"||\"\"]}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Racchiudi un segnaposto tra parentesi graffe, ad esempio {stream.resolution}. Aggiungi una condizione per i valori alternativi: {stream.resolution::exists[\"{stream.resolution} \"||\"\"]}."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt biến giữ chỗ trong dấu ngoặc nhọn, ví dụ {stream.resolution}. Thêm điều kiện để có giá trị dự phòng: {stream.resolution::exists[\"{stream.resolution} \"||\"\"]}."
          }
        }
      }
    },
