    "Send up to 5.1 channels. Larger layouts are mixed down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet bis zu 5.1 Kanäle. Größere Layouts werden heruntergemischt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía hasta 5.1 canales. Los formatos mayores se mezclan a la baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie jusqu’à 5.1 canaux. Les configurations plus grandes sont mixées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia fino a 5.1 canali. I layout più grandi vengono ridotti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi tối đa 5.1 kênh. Bố cục lớn hơn sẽ được trộn xuống."
          }
        }
      }
    },
    "Send up to 7.1 channels. Needs a receiver that accepts them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet bis zu 7.1 Kanäle. Benötigt einen Receiver, der sie akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía hasta 7.1 canales. Requiere un receptor que los admita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie jusqu’à 7.1 canaux. Nécessite un récepteur compatible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia fino a 7.1 canali. Richiede un ricevitore che li accetti."
