          }
        }
      }
    },
    "On · Play the trailer full screen shortly after opening a title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · Spielt den Trailer kurz nach dem Öffnen eines Titels im Vollbild ab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado · reproduce el tráiler a pantalla completa poco después de abrir un título"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · lit la bande-annonce en plein écran peu après l’ouverture d’un titre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "On · riproduce il trailer a schermo intero poco dopo l'apertura di un titolo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật · Phát trailer toàn màn hình ngay sau khi mở phim"
          }
        }
      }
    },
    "On · Poster and description sit in the top right, Nuvio-style": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · Poster und Beschreibung sitzen oben rechts, wie bei Nuvio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado · el póster y la descripción aparecen arriba a la derecha, al estilo Nuvio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · l’affiche et la description s’affichent en haut à droite, comme sur Nuvio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "On · poster e descrizione compaiono in alto a destra, in stile Nuvio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật · Poster và mô tả nằm ở góc trên bên phải, kiểu Nuvio"
          }
        }
      }
    },
    "On · Posters play a muted trailer preview after a moment of focus": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · Poster spielen nach kurzem Fokus eine stumme Trailer-Vorschau ab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado · los pósters reproducen una vista previa silenciada del tráiler tras un momento de enfoque"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · les affiches lancent un aperçu muet de la bande-annonce après un instant de focus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "On · i poster riproducono un'anteprima muta del trailer dopo un momento di focus"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật · Poster phát trailer tắt tiếng sau một lúc được chọn"
          }
        }
      }
    },
    "On · Scroll-geometry and push/pop counters below — photograph after testing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · Scroll-Geometrie- und Push/Pop-Zähler unten — fotografiere nach dem Testen"
          }
        },
        "es": {
