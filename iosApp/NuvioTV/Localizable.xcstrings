    "The accent color used for focus rings, highlights, and controls. Applies instantly and syncs per profile.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Akzentfarbe, die für Fokusringe, Hervorhebungen und Steuerelemente verwendet wird. Wird sofort angewendet und synchronisiert sich pro Profil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color de acento utilizado para anillos de enfoque, resaltados y controles. Se aplica instantáneamente y se sincroniza por perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur d’accentuation utilisée pour les anneaux de focus, surlignages et contrôles. S’applique instantanément et se synchronise par profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore di accento utilizzato per gli anelli di fuoco, i evidenziamenti e i controlli. Si applica istantaneamente e si sincronizza per profilo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu nhấn dùng cho viền tiêu điểm, phần tô sáng và điều khiển. Áp dụng ngay và đồng bộ theo hồ sơ."
          }
        }
      }
    },
