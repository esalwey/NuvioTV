    "settings.developer.player.darkGlass.subtitle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Old black tint under the transport bar and the player cards"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte schwarze Tönung unter der Steuerleiste und den Player-Karten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antiguo tinte negro bajo la barra de reproducción y las tarjetas del reproductor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancienne teinte noire sous la barre de transport et les cartes du lecteur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecchia tinta nera sotto la barra di trasporto e le schede del lettore"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lớp phủ đen cũ dưới thanh điều khiển và các thẻ của trình phát"
          }
        }
      }
    },
    "settings.developer.player.footer": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Both off is the intended look: see-through glass over the picture on both players. Turn one on to compare with the previous look. Applies to the next playback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides aus ist die vorgesehene Optik: durchsichtiges Glas über dem Bild in beiden Playern. Aktiviere eine Option, um sie mit der früheren Optik zu vergleichen. Gilt für die nächste Wiedergabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos desactivados es el aspecto previsto: cristal transparente sobre la imagen en los dos reproductores. Activa uno para compararlo con el aspecto anterior. Se aplica en la próxima reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux désactivés correspondent à l’aspect prévu : verre transparent sur l’image pour les deux lecteurs. Activez-en un pour comparer avec l’aspect précédent. S’applique à la prochaine lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe disattivate è l’aspetto previsto: vetro trasparente sopra l’immagine su entrambi i lettori. Attivane una per confrontare con l’aspetto precedente. Si applica alla prossima riproduzione."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai tắt là giao diện chủ đích: kính trong suốt phủ lên hình ảnh ở cả hai trình phát. Bật một tùy chọn để so sánh với giao diện trước. Áp dụng cho lần phát tiếp theo."
          }
        }
      }
    },
    "settings.developer.player.framebufferOnly": {
      "extractionState": "extracted_with_value",
      "localizations": {
