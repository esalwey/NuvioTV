    "api.nuvio.tv is the official server. Use “Use Official Server” in Settings to switch back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv ist der offizielle Server. Verwende „Offiziellen Server verwenden“ in den Einstellungen, um zurückzuwechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv es el servidor oficial. Usa “Usar servidor oficial” en Ajustes para volver."
